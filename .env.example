# Copy this file to `.env` in the same directory as docker-compose.prod.yml
# (expected at /opt/rojan/backend/.env on the target VPS) and fill in real
# values before running `docker compose -f docker-compose.prod.yml up`.
# `.env` itself must NEVER be committed — it is already in .gitignore.
#
# Every variable here is consumed either by docker-compose.prod.yml
# directly, or passed through it into the app container where
# bootstrap/src/main/resources/application.yml (and application-prod.yml)
# read it. Defaults shown in comments are what application.yml falls back
# to for local/dev use — production must set real values for every
# variable marked (required).

# ── JWT (required) ──
# HS256 signing key — must be a random string of at least 32 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=rojan-ai-backend
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# ── PostgreSQL (required) ──
# DB_HOST/DB_PORT are NOT set here on purpose — docker-compose.prod.yml
# hardcodes them to the internal `postgres` service/port; only the
# credentials and pool size are configurable.
DB_NAME=rojan
DB_USERNAME=rojan
DB_PASSWORD=
DB_POOL_SIZE=10

# ── Redis ──
# Optional: leave blank to run Redis without a password (fine on a VPS
# where Redis is not port-published to the host at all — see
# docker-compose.prod.yml). Set it for defense-in-depth anyway if you'd
# rather not rely solely on network isolation.
REDIS_PASSWORD=

# ── SMS Provider — MeliPayamak (required) ──
# Powers the phone + OTP authentication flow's SMS delivery
# (RequestOtpUseCase -> SmsProviderPort -> RealSmsProviderAdapter). No
# defaults, same posture as JWT_SECRET above — the app refuses to start
# without all three set (outside the `test` profile, which never needs
# them at all — see infrastructure/sms/LoggingSmsProvider.kt).
#
# SMS_API_URL: MeliPayamak's send endpoint, WITHOUT the API key appended —
#   e.g. https://console.melipayamak.com/api/send/simple
#   (RealSmsProviderAdapter appends /{SMS_API_KEY} itself).
# SMS_API_KEY: from your MeliPayamak console (API Key integration, not the
#   legacy username/password SOAP API). Treat exactly like a password —
#   never commit it, never log it, never paste it into a report.
# SMS_SENDER: the sender line/number MeliPayamak has approved for this
#   account — becomes the outgoing SMS's "from" field. An unapproved
#   sender is rejected by MeliPayamak at send time, not by this app.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

# ── SMS Provider — MeliPayamak Shared Pattern (optional) ──
# A second, optional SmsProviderPort implementation
# (MeliPayamakSharedPatternProvider) that relays ROJAN's own generated OTP
# into a pre-approved MeliPayamak SMS template, instead of the default
# RealSmsProviderAdapter ("Simple" endpoint, configured via SmsProperties /
# SMS_API_URL+SMS_API_KEY+SMS_SENDER). Unselected by default — leave
# SMS_PROVIDER blank to keep using the default adapter; set it to
# `melipayamak-shared` to switch, at which point MELIPAYAMAK_API_KEY and
# MELIPAYAMAK_BODY_ID become required (same fail-loud posture as JWT_SECRET).
#
# SMS_PROVIDER: leave blank to keep the default adapter, or set to
#   `melipayamak-shared` to use the Shared Pattern adapter instead.
# MELIPAYAMAK_API_KEY: from your MeliPayamak console (API Key integration).
#   Sent as a URL path segment to console.melipayamak.com/api/send/shared —
#   treat exactly like a password, never commit/log/paste it into a report.
# MELIPAYAMAK_BODY_ID: the numeric id of the pre-approved template
#   (پترن) this account created on the MeliPayamak console — ROJAN's
#   generated OTP is sent as that template's first placeholder (args[0]).
SMS_PROVIDER=
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_BODY_ID=

# ── Kafka: intentionally not part of this deployment ──
# The app has a lazily-connecting Kafka producer bean
# (infrastructure/.../KafkaProducerConfig.kt) that nothing invokes yet
# (README: "prepared, no topic in use yet"). No Kafka service is defined
# in docker-compose.prod.yml or the /opt/rojan layout for this milestone,
# and application-prod.yml disables the Kafka health indicator
# accordingly, so there is no KAFKA_BOOTSTRAP_SERVERS variable to set
# here. Add one back (plus a kafka service in compose, plus re-enabling
# `management.health.kafka.enabled`) the day a real feature needs it.

# ── Persistent data root ──
# Must match the already-provisioned VPS directory layout
# (/opt/rojan/{postgres,redis,nginx,logs,...}). Only override this if
# that layout ever moves.
ROJAN_DATA_ROOT=/opt/rojan

# ── Public base URL (required for QR/invite links) ──
# The real customer-facing domain encoded into generated salon QR codes
# and staff-invite links (SalonUseCaseConfig.kt's rojan.public.base-url).
# docker-compose.prod.yml already defaults this to https://rojanai.ir if
# unset, so leaving it blank here is safe — set it explicitly only if
# the public domain ever changes.
ROJAN_PUBLIC_BASE_URL=https://rojanai.ir

# ── Let's Encrypt / Nginx ──
# Used only by docker/nginx/init-letsencrypt.sh (not read by the app or
# by docker-compose.prod.yml itself). Documented here so every deployment
# variable lives in one place.
DOMAIN_NAME=
LETSENCRYPT_EMAIL=
