# Copy this file to `.env` in the same directory as docker-compose.prod.yml
# (expected at /opt/rojan/backend/.env on the target VPS) and fill in real
# values before running `docker compose -f docker-compose.prod.yml up`.
# `.env` itself must NEVER be committed — it is already in .gitignore.
#
# Every variable here is consumed either by docker-compose.prod.yml
# directly, or passed through it into the app container where
# bootstrap/src/main/resources/application.yml (and application-prod.yml)
# read it. Defaults shown in comments are what application.yml falls back
# to for local/dev use — production must set real values for every
# variable marked (required).

# ── JWT (required) ──
# HS256 signing key — must be a random string of at least 32 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=rojan-ai-backend
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# ── PostgreSQL (required) ──
# DB_HOST/DB_PORT are NOT set here on purpose — docker-compose.prod.yml
# hardcodes them to the internal `postgres` service/port; only the
# credentials and pool size are configurable.
DB_NAME=rojan
DB_USERNAME=rojan
DB_PASSWORD=
DB_POOL_SIZE=10

# ── Redis ──
# Optional: leave blank to run Redis without a password (fine on a VPS
# where Redis is not port-published to the host at all — see
# docker-compose.prod.yml). Set it for defense-in-depth anyway if you'd
# rather not rely solely on network isolation.
REDIS_PASSWORD=

# ── Kafka: intentionally not part of this deployment ──
# The app has a lazily-connecting Kafka producer bean
# (infrastructure/.../KafkaProducerConfig.kt) that nothing invokes yet
# (README: "prepared, no topic in use yet"). No Kafka service is defined
# in docker-compose.prod.yml or the /opt/rojan layout for this milestone,
# and application-prod.yml disables the Kafka health indicator
# accordingly, so there is no KAFKA_BOOTSTRAP_SERVERS variable to set
# here. Add one back (plus a kafka service in compose, plus re-enabling
# `management.health.kafka.enabled`) the day a real feature needs it.

# ── Persistent data root ──
# Must match the already-provisioned VPS directory layout
# (/opt/rojan/{postgres,redis,nginx,logs,...}). Only override this if
# that layout ever moves.
ROJAN_DATA_ROOT=/opt/rojan

# ── Let's Encrypt / Nginx ──
# Used only by docker/nginx/init-letsencrypt.sh (not read by the app or
# by docker-compose.prod.yml itself). Documented here so every deployment
# variable lives in one place.
DOMAIN_NAME=
LETSENCRYPT_EMAIL=
